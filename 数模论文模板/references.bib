% ============================================================================
%  references.bib —— 参考文献数据库
% ----------------------------------------------------------------------------
%  用法：在正文用 \cite{键名} 引用，例如 \cite{Hecht2002}。
%       编译两次后自动生成上标[1][2]编号。
%  下面给出期刊、书籍、标准、网页四种常用格式的示例，按需增删。
% ============================================================================

% ---- 期刊论文 ----
@article{key_example,
  author  = {作者一 and 作者二 and 作者三},
  title   = {论文标题},
  journal = {期刊名},
  year    = {2024},
  volume  = {10},
  number  = {2},
  pages   = {100--110},
  doi     = {10.xxxx/xxxxx}
}

% ---- 书籍 ----
@book{Hecht2002,
  author    = {Hecht, Eugene},
  title     = {Optics},
  edition   = {4},
  publisher = {Addison-Wesley / Pearson},
  year      = {2002},
  address   = {San Francisco}
}

% ---- 国家标准 ----
@misc{GBT42905-2023,
  title        = {{GB/T 42905-2023} 标准名称},
  howpublished = {国家市场监督管理总局, 国家标准化管理委员会},
  year         = {2023},
  url          = {https://openstd.samr.gov.cn}
}

% ---- 网页 / 在线资料 ----
@misc{web_example,
  author       = {机构或作者},
  title        = {网页标题},
  howpublished = {在线资料},
  year         = {2025},
  note         = {访问日期：2026-08-10},
  url          = {https://example.com}
}

% ---- 中文学术论文 ----
@article{中文示例,
  author  = {作者甲 and 作者乙},
  title   = {中文论文标题},
  journal = {中文期刊名},
  year    = {2023},
  volume  = {45},
  pages   = {200--210},
  doi     = {10.xxxx/xxxxx}
}

% ============================================================================
%  提示：
%  1. \cite{key_example} 引用键名必须与上面大括号里的键名完全一致。
%  2. 引用 AI 工具（如 ChatGPT、DeepSeek）在竞赛中一律不要写进参考文献。
%  3. 参考文献数量建议 8~15 篇，正文中每篇都要被实际引用到。
% ============================================================================
