# ===== LLM 提供商（OpenAI 兼容，必填）=====
# 支持 OpenAI 官方、国内兼容中转（DeepSeek/智谱/Qwen 等）或本地 vLLM/Ollama 端点。
API_KEY=sk-your-api-key
MODEL=gpt-4o
BASE_URL=https://api.openai.com/v1

# ===== 文献/网络搜索（可选，研究手用）=====
TAVILY_API_KEY=

# ===== Agent 运行参数（可选，均有默认值）=====
RMA_CONTEXT_TOKEN_LIMIT=400000
RMA_BASH_DEFAULT_TIMEOUT_SECONDS=120
RMA_BASH_MAX_TIMEOUT_SECONDS=600
RMA_BASH_MAX_OUTPUT_CHARS=6000
RMA_BASH_ENV_FILE=
RMA_CHECKPOINT_MODE=light
RMA_TRACE_MODE=on
RMA_LATEX_ENGINE=xelatex    # 论文编译引擎（国赛模板仅支持 XeLaTeX）
RMA_PAPER_TEMPLATE_DIR=数模论文模板   # 国赛论文模板目录（写作手首跑 seed 到工作区）

# ===== 各 Agent 反馈闭环轮次上限（可选，均有默认值）=====
RMA_PLANNER_MAX_LOOPS=12     # planner 监督循环
RMA_VERIFIER_MAX_LOOPS=10    # verifier 验收循环
RMA_MODELER_MAX_LOOPS=24     # 建模手（研究↔建模 + 建模↔代码 两阶段闭环）
RMA_CODER_MAX_LOOPS=14       # 编程手（逐问求解 + 出图 + 修图）
RMA_WRITER_MAX_LOOPS=28      # 论文手（写作轮全文 + 图表轮逐问把关 + 编译）
RMA_RESEARCH_MAX_LOOPS=6     # 研究手（真实联网检索）
